# ---------------------------------------------------------------------------
# CONNECTOME LAB — environment configuration
# Copy to .env.local. NEVER commit a real token: it grants your CAVE identity.
# ---------------------------------------------------------------------------

# Fish1 CAVE access token.
# Obtain by visiting (while logged in to the Fish1/CAVE deployment):
#   https://global.brain-wire-test.org/sticky_auth/settings/tokens
# The Python tooling stores the same token at
#   ~/.cloudvolume/secrets/cave-secret.json
# This variable is read ONLY in server-side code (src/datasets/fish1/cave-client.ts).
# It is never bundled into browser JavaScript.
CAVE_TOKEN=

# CAVE deployment endpoints (defaults match the official Fish1 documentation).
CAVE_GLOBAL_URL=https://global.brain-wire-test.org
CAVE_LOCAL_URL=https://pcgv3local.brain-wire-test.org
FISH1_DATASTACK=fish1_full
FISH1_PCG_TABLE=fish1_v250915

# Pin a materialization version for reproducibility. Empty = resolve latest.
FISH1_MATERIALIZATION_VERSION=

# Upstream response cache TTL, seconds.
CAVE_CACHE_TTL_SECONDS=900
